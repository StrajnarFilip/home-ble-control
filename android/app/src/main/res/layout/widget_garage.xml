<?xml version="1.0" encoding="utf-8"?>
<!-- Garage door button (2/3) and relay toggle (1/3). Text colors are set from GarageWidget. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:baselineAligned="false"
    android:clipToOutline="true"
    android:orientation="horizontal"
    android:padding="6dp">

    <LinearLayout
        android:id="@+id/widget_garage"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="2"
        android:background="@drawable/widget_button"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingHorizontal="10dp">

        <!-- Shrinks to fit longer translations (e.g. "Garažna vrata"). -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="24dp"
            android:autoSizeMaxTextSize="17sp"
            android:autoSizeMinTextSize="11sp"
            android:autoSizeStepGranularity="1sp"
            android:autoSizeTextType="uniform"
            android:gravity="center"
            android:maxLines="1"
            android:text="@string/garage_door"
            android:textColor="@color/widget_text"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/widget_text_dim"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_relay"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginStart="6dp"
        android:layout_weight="1"
        android:background="@drawable/widget_button"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_relay_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:text="@string/relay"
            android:textColor="@color/widget_text_dim"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/widget_relay_state"
            android:layout_width="match_parent"
            android:layout_height="24dp"
            android:autoSizeMaxTextSize="17sp"
            android:autoSizeMinTextSize="11sp"
            android:autoSizeStepGranularity="1sp"
            android:autoSizeTextType="uniform"
            android:gravity="center"
            android:maxLines="1"
            android:paddingHorizontal="4dp"
            android:text="@string/widget_relay_unknown"
            android:textColor="@color/widget_text"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
